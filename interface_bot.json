    {
      "parameters": {
        "jsCode": "const update = $input.first().json;\nconst adminGroup = -1004341021033;\n\nif (!update.message) return [];\n\n// 1. Адмін пише відповідь клієнту\nif (update.message.chat.id == adminGroup && update.message.message_thread_id) {\n  if (update.message.text) {\n    return [{ json: { action: 'admin_reply', text: update.message.text, message_thread_id: update.message.message_thread_id } }];\n  }\n  return []; \n}\n\n// 2. Клієнт пише боту\nif (update.message.chat.id > 0 && update.message.text !== '/start') {\n  // Захист: якщо клієнт прислав тільки цифри (вводить бюджет) — не пересилаємо це в CRM\n  if (/^\\s*\\d+\\s*$/.test(update.message.text)) {\n      return []; \n  }\n\n  let replyText = \"\";\n  if (update.message.reply_to_message) {\n      replyText = update.message.reply_to_message.text || update.message.reply_to_message.caption || \"\";\n  }\n  return [{ json: { action: 'user_message', telegram_id: update.message.chat.id, message_id: update.message.message_id, reply_text: replyText } }];\n}\n\nreturn [];"
      },
