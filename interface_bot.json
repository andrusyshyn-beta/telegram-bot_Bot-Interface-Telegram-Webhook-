    {
      "parameters": {
        "jsCode": "const inputData = $('Parse Input').first().json;\nconst users = $input.all();\nconst chatId = String(inputData.chatId);\n\nlet user = users.find(u => String(u.json['Telegram ID']) === chatId);\nlet state = user ? (user.json.State || 'new') : 'new';\nlet action = 'ignore';\n\nif (inputData.text === '/start') {\n  action = 'ask_rooms';\n} else if (state === 'waiting_rooms' && inputData.isCallback) {\n  action = 'ask_district';\n} else if (state === 'waiting_district' && inputData.isCallback) {\n  action = 'ask_price';\n} else if (state === 'waiting_price' && !inputData.isCallback) {\n  if (!isNaN(inputData.text) && parseInt(inputData.text) >= 4000 && parseInt(inputData.text) <= 20000) {\n    action = 'finish';\n  } else {\n    action = 'invalid_price';\n  }\n}\n\nreturn { json: { chatId: inputData.chatId, state, action, text: inputData.text, callbackData: inputData.callbackData, rowNumber: user ? user.json.row_number : null } };"
      },
