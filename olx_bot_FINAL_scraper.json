    {
      "parameters": {
        "jsCode": "// Отримуємо всі записи з таблиці\nconst sentItems = $('Read Sent Items').all();\n\n// Створюємо список вже відправлених квартир для цього клієнта\nconst sentSet = new Set();\nfor (const sent of sentItems) {\n  if (sent.json['Telegram ID'] && sent.json['Item ID']) {\n    sentSet.add(String(sent.json['Telegram ID']) + '_' + String(sent.json['Item ID']));\n  }\n}\n\n// Фільтруємо нові квартири\nconst newItems = [];\nfor (const item of $input.all()) {\n  const telegramId = String(item.json.chatId); \n  const itemId = String(item.json.id);\n  const key = telegramId + '_' + itemId;\n  \n  // Якщо такої квартири ще не було у цього клієнта - пропускаємо далі\n  if (!sentSet.has(key)) {\n    newItems.push(item);\n  }\n}\n\nreturn newItems;"
      },
