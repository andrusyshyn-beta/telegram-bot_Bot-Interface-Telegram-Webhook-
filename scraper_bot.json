    {
      "parameters": {
        "jsCode": "// Отримуємо всі записи з таблиці\nconst sentItems = $('Read Sent Items').all();\n\n// Створюємо список вже знайдених квартир (і відправлених, і pending)\nconst sentSet = new Set();\nfor (const sent of sentItems) {\n  if (sent.json['Telegram ID'] && sent.json['Item ID']) {\n    sentSet.add(String(sent.json['Telegram ID']) + '_' + String(sent.json['Item ID']));\n  }\n}\n\nconst newItems = [];\nconst usersWhoGotItems = new Set();\n\nfor (const item of $input.all()) {\n  const telegramId = String(item.json.chatId); \n  const itemId = String(item.json.id);\n  const key = telegramId + '_' + itemId;\n  \n  if (!sentSet.has(key)) {\n    // Зберігаємо весь JSON об'єкт як строку, щоб Sender міг його прочитати\n    item.json.message_type = 'apartment';\n    item.json.payload = JSON.stringify(item.json);\n    newItems.push(item);\n    usersWhoGotItems.add(telegramId);\n  }\n}\n\nconst activeUsers = $items(\"Filter Active\");\nfor (const u of activeUsers) {\n  const user = u.json;\n  if (user.State === 'first_run') {\n    const telegramId = String(user['Telegram ID']);\n    if (!usersWhoGotItems.has(telegramId)) {\n      newItems.push({\n        json: {\n          message_type: 'empty_notification',\n          chatId: telegramId,\n          adminTopicId: user['Admin Topic ID'],\n          payload: ''\n        }\n      });\n    }\n    newItems.push({\n      json: {\n        message_type: 'upgrade_state',\n        chatId: telegramId,\n        payload: ''\n      }\n    });\n  }\n}\n\nreturn newItems;"
      },
