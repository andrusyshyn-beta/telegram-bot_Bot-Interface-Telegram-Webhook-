      "id": "721b7794-3d09-4aaa-83db-91b995fdf552",
      "name": "OLX API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -2496,
        832
      ]
    },
    {
      "parameters": {
        "jsCode": "const results = [];\nconst allInputs = $input.all();\nconst activeUsers = $items(\"Filter Active\");\n\nfor (let i = 0; i < allInputs.length; i++) {\n  const response = allInputs[i].json;\n  const offers = response.data || [];\n  \n  const user = activeUsers[i].json;\n  const userDistrict = user.District || 'any';\n\n  for (const offer of offers) {\n    const distName = (offer.location?.district?.name || '').toLowerCase();\n    if (userDistrict !== 'any' && !distName.includes(userDistrict.toLowerCase())) continue;\n    \n    let area = '', floor = '', rent = '', deposit = '', priceStr = '';\n    \n    for (const p of offer.params || []) {\n      if (p.key === 'm') area = p.value?.label;\n      if (p.key === 'floor_select') floor = p.value?.label;\n      if (p.key === 'rent') rent = p.value?.label;\n      if (p.key === 'deposit') deposit = p.value?.label;\n      if (p.key === 'price') priceStr = p.value?.value;\n    }\n    \n    let hasOtodomPhotos = false;\n    const photos = [];\n    \n    if (offer.photos && Array.isArray(offer.photos)) {\n      for (const p of offer.photos) {\n        const photoUrl = (p.link || '').toLowerCase();\n        if (photoUrl.includes('otodom') || photoUrl.includes('uicdn') || photoUrl.includes('rfrcdn')) {\n          hasOtodomPhotos = true;\n          break; \n        }\n        photos.push({ type: 'photo', media: p.link.replace('{width}', '800').replace('{height}', '600') });\n      }\n    }\n    \n    if (hasOtodomPhotos || photos.length === 0) continue;\n    \n    let userMsg = `✨ ${user.Rooms} кімнат(и), ${area}\\n`;\n    if (priceStr) userMsg += `💰 Орендна плата - ${priceStr} PLN\\n`;\n    userMsg += `\\n📍 Варшава, ${offer.location?.district?.name || ''}\\n\\n`;\n    if (floor) userMsg += `🏢 Поверх: ${floor}\\n`;\n    if (deposit) userMsg += `💰 Кауція: ${deposit}\\n`;\n    if (rent) userMsg += `📋 Чинш: ${rent}\\n`;\n    userMsg += `\\n💬 Щоб дізнатися деталі, просто дайте відповідь на це повідомлення!`;\n    \n    let adminMsg = `[КОПІЯ] Клієнт ID: ${user['Telegram ID']}\\n${userMsg}\\n\\n🔗 ${offer.url}`;\n    \n    const userPhotos = JSON.parse(JSON.stringify(photos.slice(0, 10)));\n    userPhotos[0].caption = userMsg.substring(0, 1024);\n    \n    const adminPhotos = JSON.parse(JSON.stringify(photos.slice(0, 10)));\n    adminPhotos[0].caption = adminMsg.substring(0, 1024);\n    \n    results.push({\n      json: {\n        id: offer.id,\n        userMedia: JSON.stringify(userPhotos),\n        adminMedia: JSON.stringify(adminPhotos),\n        chatId: user['Telegram ID'],\n        adminTopicId: user['Admin Topic ID'] // <--- ОСЬ ТУТ ДОДАВСЯ НОМЕР КІМНАТИ!\n      }\n    });\n  }\n}\n\nreturn results;"
      },
